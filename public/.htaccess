<IfModule mod_rewrite.c>
  Options -Multiviews
  RewriteEngine On
  RewriteBase /

  # Serve existing assets and files directly
  RewriteRule ^assets/ - [L]
  RewriteRule ^(index\.html|robots\.txt|sitemap\.xml|vite\.svg)$ - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback to SPA index.html
  RewriteRule ^ index.html [L,QSA]
</IfModule>
